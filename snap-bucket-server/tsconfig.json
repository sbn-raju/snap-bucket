{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution":
      "Bundler",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "declaration": true,

    "esModuleInterop":
      true,

    "skipLibCheck": true,

    "ignoreDeprecations":
      "6.0"
  },

  "include": ["src"]
}