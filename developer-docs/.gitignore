```gitignore
# Dependencies
node_modules/

# Build output
dist/
docs/.vitepress/dist/
.vitepress/dist/
.vitepress/cache/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables / secrets
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo

# Coverage
coverage/

# TypeScript
*.tsbuildinfo

# Cache
.cache/
.temp/
tmp/
.eslintcache

# Package manager lock files (choose one)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Generated API docs (if auto-generated)
typedoc/

# Local config files
*.local

# GitHub Pages temp files
docs/.vitepress/cache/

# Build artifacts
out/
build/

# AWS credentials (VERY IMPORTANT)
.aws/
credentials.json
secret.json
service-account.json

# npm publish secrets
.npmrc
```
